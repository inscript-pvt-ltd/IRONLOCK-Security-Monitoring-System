<?xml version="1.0" encoding="utf-8"?>
<!--
  Production backend is HTTPS (dashboard.ironlock.co.uk), so cleartext is denied
  everywhere by default. The only cleartext allowance is the local mock backend
  during development (loopback + the Android-emulator host alias 10.0.2.2). No
  real/remote host can be reached over HTTP.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false"/>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
    </domain-config>
</network-security-config>
