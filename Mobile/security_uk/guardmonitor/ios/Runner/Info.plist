<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The shift-access SSO deep link (ironlock://shift-access/<token>) is handled
	     entirely by the app_links plugin (deep_link_service.dart). Disable Flutter's
	     BUILT-IN deep linking so the engine doesn't ALSO push the link's path as a
	     named route — with no router that throws "Could not find a generator for
	     route /<token>". app_links keeps working (separate channel). -->
	<key>FlutterDeepLinkingEnabled</key>
	<false/>
	<key>NSCameraUsageDescription</key>
	<string>Ironlock Guard Monitor needs camera access to capture photo verification images during your shift.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Ironlock Guard Monitor uses your location to verify you are on site and track your patrol zone during your shift.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Ironlock Guard Monitor uses your location to verify you are on site and track your patrol zone during your shift, including while the app is in the background.</string>
	<!-- Background patrol tracking: continue location updates when the app is
	     backgrounded or the screen is locked during a shift.
	     `remote-notification` lets FCM/APNs wake the app for background data
	     pushes (wakefulness / photo requests). NOTE: background push only works
	     once the APNs auth key is uploaded to Firebase and the Push Notifications
	     capability + `aps-environment` entitlement are added under an Apple
	     Developer account — see docs/IOS_PARITY_TODO.md. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
		<string>remote-notification</string>
	</array>
	<!-- The production backend is HTTPS (dashboard.ironlock.co.uk), so App
	     Transport Security stays fully ON for the internet — no cleartext
	     exception for any real host. NSAllowsLocalNetworking only permits the
	     local mock backend (http://127.0.0.1:8000) during dev; it does NOT relax
	     ATS for remote hosts. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- Shift Access Link (SSO): custom URL scheme ironlock://shift-access/<token>.
	     Opens the app from a supervisor one-time link without an Apple Developer
	     account (the https page redirects to this scheme). Universal Links — the
	     tap-the-https-link path — need the Associated Domains entitlement (Apple
	     account) + the server's apple-app-site-association; add those later. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.ironlock.guardmonitor.shiftaccess</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>ironlock</string>
			</array>
		</dict>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>IronLock</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>guardmonitor</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
